# Explicit frozen publication entry: node vps/publication-main.mjs
# TEMPLATE ONLY. Keep the real env file outside Git; never put secrets in argv.
# Required independent build/source pins must come from the trusted build.
EDITOR_ORIGIN=https://dragon-editor.720108.xyz
EDITOR_REQUEST_KEY=
EDITOR_DEFAULT_PASSWORD=
# Pre-create this private directory for the service uid (0700 on Linux).
EDITOR_DATA_DIR=/srv/dragon-editor/data
EDITOR_LISTEN_HOST=127.0.0.1
EDITOR_LISTEN_PORT=8788
EDITOR_DRAIN_INTERVAL_MS=1000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dragon
# Explicit empty prefix selects the production namespace. Isolated tests may
# instead use test/<unique-id>/ with a separate owned database.
R2_PREFIX=
STATIC_ORIGIN=
STATIC_PATH_PREFIX=
STATIC_RELEASE_SHA256=
STATIC_SOURCE_SHA256=
# Optional EDITOR_INSTALLED_SOURCE_ROOT / EDITOR_AVAILABLE_LIBRARY_ROOT: omit
# unless an operator has staged and read back the exact pinned private objects.
# Values are JSON {"registryId":"...","root":{"sha256":"...","byteLength":1}}.
# Setting a descriptor is not an approval; register through the shared admin API.
# Do not register an available library with stale consumer fingerprints.
# Optional EDITOR_REGISTER_SOURCE=1 (needs EDITOR_INSTALLED_SOURCE_ROOT): before
# the port opens, seeds the admin account if the database is empty and registers
# the staged fixed source through the real install path (full pinned-byte check
# plus a source_operations receipt). A drifted pinned root fails startup instead
# of overwriting the existing registration.
# No EDITOR_PLAY_ORIGIN, legacy auth mode, implicit database or pin discovery.
